# Frontend settings. Copy to frontend/.env.local and never commit the copy.
# Next.js only reads env files from its own folder, so these can't live in the root .env.
# Every NEXT_PUBLIC_ value is sent to the browser, so never put a secret in this file.
# Restart `npm run dev` after changing it.

# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Your Supabase project URL. Leave both Supabase values empty to keep sign-in off.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key (sb_publishable_...), which is safe in the browser. Not the secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
