# Copy to .env in the repo root. Never commit the copy.

# Backend: comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Backend: identifies scan traffic. Must link to the "about our scanner" page.
SCANNER_USER_AGENT=ScanKitBot/0.1 (+https://scankit.example/about-scanner)

# Backend: optional comma-separated DNS server IPs for scan lookups, e.g. 1.1.1.1,8.8.8.8
# Leave empty to use the system's DNS. Set it if lookups time out because the machine
# lists dead DNS servers, which is common on Windows with disconnected adapters.
SCANNER_DNS_SERVERS=

# Backend: seconds each DNS resolver gets before falling back to the next one
# (UDP, then TCP, then DNS-over-HTTPS, then the operating system). Range: above 0, up to 30.
# Networks that block UDP DNS wait this long on every lookup, so a lower value is faster there.
SCANNER_DNS_TIMEOUT_SECONDS=5

# Use 127.0.0.1 for the docker-compose services, not localhost. They are published on
# IPv4 only, and on Windows localhost tries IPv6 first, which stalls new connections.

# Redis from docker-compose: the Celery broker and the rate limit counters
REDIS_URL=redis://127.0.0.1:6379/0

# Postgres from docker-compose. These credentials are for local development only.
# In production, use the Supabase connection string.
DATABASE_URL=postgresql+psycopg://scankit:scankit_dev@127.0.0.1:5432/scankit

# Frontend: Next.js only reads env files from its own folder,
# so put this line in frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
