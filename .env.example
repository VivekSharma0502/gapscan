# Backend settings. Copy to .env in the repo root and never commit the copy.
# Every value here is a placeholder or a local-only default.
# The frontend has its own file: see frontend/.env.example.
# Step-by-step setup: docs/SELF_HOSTING.md

# --- API ---

# Comma-separated browser origins allowed to call the API. Never use "*".
CORS_ORIGINS=http://localhost:3000

# --- Database and queue ---
# Use 127.0.0.1 for the docker-compose services, not localhost. They are published on
# IPv4 only, and on Windows localhost tries IPv6 first, which stalls new connections.

# Postgres from docker-compose. These credentials are for local development only.
# In production, use your own connection string.
DATABASE_URL=postgresql+psycopg://gapscan:gapscan_dev@127.0.0.1:5432/gapscan

# Redis from docker-compose: the Celery broker and, by default, the rate limit counters.
REDIS_URL=redis://127.0.0.1:6379/0

# Where rate limit counters live. Leave unset to use REDIS_URL, so limits hold across
# API processes.
# RATE_LIMIT_STORAGE_URL=redis://127.0.0.1:6379/1

# --- Scanner ---

# Identifies scan traffic. If you self-host, link to a page of your own, so a site owner
# can find out who is scanning them and how to reach you.
# Left unset, it is built from the name in product.json and links to the project.
# SCANNER_USER_AGENT=GapScanBot/1.0 (+https://example.com/about-our-scanner)

# Optional comma-separated DNS server IPs for scan lookups, e.g. 1.1.1.1,8.8.8.8
# Leave empty to use the system's DNS. Set it if lookups time out, because the machine
# lists dead DNS servers or the network blocks UDP port 53.
SCANNER_DNS_SERVERS=

# Seconds each DNS resolver gets before falling back to the next one (UDP, then TCP, then
# DNS-over-HTTPS, then the operating system). Range: above 0, up to 30.
# Networks that block UDP DNS wait this long on every lookup, so a lower value is faster there.
SCANNER_DNS_TIMEOUT_SECONDS=5

# --- Sign-in (Supabase Auth) ---
# Leave both empty to keep sign-in off. Quick scans still work.
# The backend needs no Supabase secret. Never put the service role key or JWT secret here.

# Your Supabase project URL, used to fetch the public keys that verify sign-ins.
SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key, the same value as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY in the frontend.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# --- Repo scanning (your GitHub App) ---
# Leave these empty to keep repo scanning off.

# The App ID shown on the app's settings page.
GITHUB_APP_ID=
# The name in the app's URL: github.com/apps/<slug>
GITHUB_APP_SLUG=
# Secret. The app's .pem private key, base64-encoded onto one line.
GITHUB_APP_PRIVATE_KEY_B64=
# Secret. The same random value as the app's webhook secret.
GITHUB_WEBHOOK_SECRET=
# A full path to gitleaks, only if it isn't on the worker's PATH.
# GITLEAKS_PATH=gitleaks
