# Copy to .env in the repo root. Never commit the copy.

# Backend: comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Redis from docker-compose (used from Phase 1 onwards)
REDIS_URL=redis://localhost:6379/0

# Frontend: Next.js only reads env files from its own folder,
# so put this line in frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
